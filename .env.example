# Copy this file to .env and fill in your own values. Never commit .env.

# Login page of the ESS portal
ESS_LOGIN_URL=https://live.oxygene.co.ke:8433/ess/web/ess/login

# Your ESS credentials
ESS_USER_ID=your-user-id
ESS_PASSWORD=your-password

# The timesheet line entered for every day in the range
ESS_PROJECT=200041000102
ESS_CATEGORY=LA07
ESS_NOTE=DRM
ESS_HOURS=8

# false = show the browser window while the script runs (useful for the first runs)
ESS_HEADLESS=false

# The portal's TLS certificate is missing its issuer, so verification is off by default
ESS_VERIFY_SSL=false

# The portal allows one session per user. true = if you are already signed in somewhere
# else, close that session and sign in here. false = stop with an error instead.
ESS_FORCE_LOGIN=false

# Seconds to wait for login to finish (covers a Company ID / verify code dialog)
ESS_LOGIN_TIMEOUT=90
